APP_PORT=2283
IMMICH_VERSION=v3.2.2
TZ=Asia/Shanghai

# 已有 PostgreSQL：同一 local_network 下可填写容器名，使用容器内部端口。
# 远程 PostgreSQL 请填写实际地址和端口，并提前创建 immich 数据库。
DB_HOSTNAME=postgresql
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace_with_your_pg_password
DB_DATABASE_NAME=immich
# 对应 app/postgresql 的 pgvector 镜像；使用 VectorChord 时改为 vectorchord。
DB_VECTOR_EXTENSION=pgvector

# 已有 Redis：地址、端口和密码需与实际配置一致；无密码时留空。
REDIS_HOSTNAME=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
# 与其他应用使用不同的数据库索引，按已有 Redis 的占用情况调整。
REDIS_DBINDEX=1
