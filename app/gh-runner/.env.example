RUNNER_COUNT=2
RUNNER_NAME_PREFIX=docker-runner
# RUNNER_TOKEN 是使用一次性token。
RUNNER_TOKEN=
# ACCESS_TOKEN 是使用个人token，虽然可以一劳永逸，但是为了安全起见请使用 RUNNER_TOKEN
ACCESS_TOKEN=
RUNNER_SCOPE=org
ORG_NAME=orgname
REPO_URL=https://github.com/你的用户名/你的仓库名
RUNNER_GROUP=default
LABELS=self-hosted,linux
# 是否启动容器内 Docker；需要 Docker 构建的 CI 设为 true。
START_DOCKER_SERVICE=false
RUNNER_IMAGE=myoung34/github-runner:latest
